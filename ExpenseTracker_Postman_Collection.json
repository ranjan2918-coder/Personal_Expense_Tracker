{
  "info": {
    "name": "Personal Expense Tracker API",
    "description": "Complete collection for testing all REST API endpoints of the Personal Expense Tracker backend. Base URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "health"]
        },
        "description": "Verify the API server is running. Expected: 200 OK with {\"status\":\"UP\"}"
      }
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "GET All Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/expenses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "expenses"]
            },
            "description": "Returns all expenses as a JSON array. Expected: 200 OK"
          }
        },
        {
          "name": "GET Expense by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/expenses/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "expenses", "1"]
            },
            "description": "Returns a single expense by ID. Change '1' to any valid ID. Expected: 200 OK or 404 Not Found"
          }
        },
        {
          "name": "POST Add Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lunch at Restaurant\",\n  \"amount\": 350.00,\n  \"category\": \"Food\",\n  \"description\": \"Team lunch outing\",\n  \"expense_date\": \"2026-10-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:8080/api/expenses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "expenses"]
            },
            "description": "Adds a new expense. Expected: 201 Created with the new ID"
          }
        },
        {
          "name": "PUT Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grocery Shopping (Updated)\",\n  \"amount\": 1800.00,\n  \"category\": \"Food\",\n  \"description\": \"Updated monthly groceries\",\n  \"expense_date\": \"2026-10-30\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:8080/api/expenses/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "expenses", "1"]
            },
            "description": "Updates expense with ID 1. Change ID as needed. Expected: 200 OK with updated expense JSON"
          }
        },
        {
          "name": "DELETE Expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/expenses/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "expenses", "1"]
            },
            "description": "Deletes expense with ID 1. Expected: 200 OK or 404 Not Found"
          }
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "GET All Budgets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/budgets",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "budgets"]
            },
            "description": "Returns all budgets as a JSON array. Expected: 200 OK"
          }
        },
        {
          "name": "POST Add Budget",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Travel\",\n  \"monthly_limit\": 5000.00,\n  \"month\": 11,\n  \"year\": 2026\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:8080/api/budgets",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "budgets"]
            },
            "description": "Adds a new monthly budget. Expected: 201 Created with new budget ID"
          }
        }
      ]
    }
  ]
}
